[ghq]
	username = kokoichi206
[user]
	name = kokoichi206
	email = 52474650+kokoichi206@users.noreply.github.com
	# signingkey は GPG 鍵の指紋で、鍵への参照を指定。
	# 鍵の実体は ~/.gnupg/ にあり、別 PC で署名するにはその PC のキーリングへ秘密鍵を import する必要がある:
	#   旧PCでexport: gpg --export-secret-keys --armor F98180B6D8286AA0A40FB9FF315BE4660DC92770 > private.key
	#   新PCでimport: gpg --import private.key && gpg --edit-key F98180B6D8286AA0A40FB9FF315BE4660DC92770 trust
	signingkey = F98180B6D8286AA0A40FB9FF315BE4660DC92770
[include]
	path = ~/.gitconfig-email
# 指定された配下のリポジトリを操作する場合のみ、設定値を読み込む。
# 後から設定された値が上書きされる。
[includeIf "gitdir:~/src/company/**"]
	path = ~/.gitconfig-company
[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
	allowed = AKIAIOSFODNN7EXAMPLE
	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
[init]
	templatedir = ~/.git-templates/git-secrets
[core]
	excludesfile = /Users/kokoichi/.gitignore_global
	editor = vim
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Users/kokoichi/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[alias]
	sw = !git branch --all --format=\"%(refname:short)\" | fzf | xargs git checkout
